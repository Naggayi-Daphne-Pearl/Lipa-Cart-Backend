HOST=0.0.0.0
PORT=1337
# For Railway/Render/reverse proxies, keep this true so HTTPS cookies work.
IS_PROXIED=true
# PUBLIC_URL=https://your-backend-domain.up.railway.app
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local development database (SQLite - default)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production database (Supabase PostgreSQL)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Sentry error tracking
SENTRY_DSN_BACKEND=https://your-key@o0.ingest.us.sentry.io/your-project-id
# SENTRY_ENV=production

# Google OAuth web client ID (used to verify Google sign-in tokens)
GOOGLE_WEB_CLIENT_ID=461833863082-gkset420arg3nqcip15jm9ptclom7g9e.apps.googleusercontent.com

# Firebase Cloud Messaging (push notifications)
# Download your service account key from Firebase Console:
#   Project Settings → Service accounts → Generate new private key
# Then either set the path to the JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or set the JSON content directly (for Railway/Render/Vercel):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...",...}

# Email (Nodemailer SMTP) — for order confirmation & delivery receipts
# Use any SMTP provider: Gmail, SendGrid, Mailgun, Zoho, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=LipaCart <noreply@lipacart.com>

# SMS (Africa's Talking) — for OTP delivery in Uganda/Kenya
# Sign up at https://africastalking.com — free sandbox for testing
# AT_USERNAME=sandbox
# AT_API_KEY=your-api-key-from-dashboard
# AT_SENDER_ID=LipaCart

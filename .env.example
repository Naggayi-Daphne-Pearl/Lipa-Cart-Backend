HOST=0.0.0.0
PORT=1337
# For Railway/Render/reverse proxies, keep this true so HTTPS cookies work.
IS_PROXIED=true
# Set this in production to your real backend URL so admin/auth redirects stay correct.
# PUBLIC_URL=https://your-backend-domain.up.railway.app
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local development database (SQLite - default)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production database (Supabase PostgreSQL)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Sentry error tracking
SENTRY_DSN_BACKEND=https://your-key@o0.ingest.us.sentry.io/your-project-id
# SENTRY_ENV=production

# Google OAuth web client ID (used to verify Google sign-in tokens)
GOOGLE_WEB_CLIENT_ID=461833863082-gkset420arg3nqcip15jm9ptclom7g9e.apps.googleusercontent.com

# Firebase Cloud Messaging (push notifications)
# Download your service account key from Firebase Console:
#   Project Settings → Service accounts → Generate new private key
# Then either set the path to the JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or set the JSON content directly (for Railway/Render/Vercel):
# nosemgrep: generic.secrets.security.detected-google-gcm-service-account.detected-google-gcm-service-account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...",...}

# Email (Nodemailer SMTP) — for OTP, order confirmation & delivery receipts
#
# Using SendGrid (recommended for Railway — reliable from cloud IPs):
# 1. Sign up at https://sendgrid.com (free tier: 100 emails/day forever)
# 2. Settings → Sender Authentication → verify lipacart.com domain (SPF + DKIM DNS)
# 3. Settings → API Keys → Create API Key (Full Access or Restricted to Mail Send)
# 4. Use the literal string "apikey" as SMTP_USER and the API key as SMTP_PASS
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=LipaCart <noreply@lipacart.com>
#
# Alternative providers (same Nodemailer code, just different host/port):
#   Gmail: smtp.gmail.com:587 (⚠️ unreliable from Railway — times out)
#   Mailgun: smtp.mailgun.org:587
#   Brevo: smtp-relay.brevo.com:587
#
# Support contact shown in email footers & reply-to headers
# SUPPORT_EMAIL=daphnepearl101@gmail.com

# Cloudinary image hosting — replaces ephemeral disk uploads on Railway/Render
# Get these from Cloudinary Console → Settings → API Keys
# CLOUDINARY_NAME=your-cloud-name
# CLOUDINARY_KEY=your-api-key
# CLOUDINARY_SECRET=your-api-secret

# SMS (Africa's Talking) — for OTP delivery in Uganda/Kenya
# Sign up at https://africastalking.com — free sandbox for testing
# AT_USERNAME=sandbox
# AT_API_KEY=your-api-key-from-dashboard
# AT_SENDER_ID=LipaCart

# PawaPay mobile money payments
# Get API credentials from https://dashboard.pawapay.io
# PAWAPAY_API_KEY=your-pawapay-api-key
# PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# PAWAPAY_COUNTRY=UGA
# PAWAPAY_CURRENCY=UGX
# PAWAPAY_CORRESPONDENT_UG=MTN_MOMO_UGA
# Optional extra charge added to mobile money totals (flat UGX and/or percentage)
# PAWAPAY_CHARGE_FLAT=250
# PAWAPAY_CHARGE_PERCENT=1.5
# Optional: if PawaPay should call your backend asynchronously
# PAWAPAY_CALLBACK_URL=https://your-backend-domain/api/payments/pawapay/webhook
# Optional shared token check for webhook security
# PAWAPAY_WEBHOOK_TOKEN=change-me

# Flutterwave v4 mobile money payments (active provider)
# Get sandbox credentials from https://developer.flutterwave.com
# FLUTTERWAVE_CLIENT_ID=your-client-id
# FLUTTERWAVE_CLIENT_SECRET=your-client-secret
# FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key
# FLUTTERWAVE_BASE_URL=https://developersandbox-api.flutterwave.com
# Optional: webhook hash secret configured in the Flutterwave dashboard
# FLUTTERWAVE_WEBHOOK_SECRET=change-me
# Optional: where Flutterwave should redirect after a successful payment
# FLUTTERWAVE_REDIRECT_URL=https://your-frontend-domain/customer/order-success

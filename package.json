{
  "name": "lc",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "SKIP_BOOTSTRAP_SYNC=true strapi develop --no-watch-admin",
    "develop:full": "FORCE_BOOTSTRAP_SYNC=true strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "predeploy": "npm run check:build && npm run check:types",
    "check:build": "strapi build",
    "check:types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "seed": "node dist/scripts/run-seed.js"
  },
  "dependencies": {
    "@sentry/node": "^10.48.0",
    "@strapi/plugin-cloud": "5.33.4",
    "@strapi/plugin-users-permissions": "5.33.4",
    "@strapi/provider-upload-cloudinary": "^5.42.0",
    "@strapi/strapi": "5.33.4",
    "africastalking": "^0.7.0",
    "better-sqlite3": "12.8.0",
    "firebase-admin": "^13.8.0",
    "fs-extra": "^10.0.0",
    "mime-types": "^2.1.27",
    "nodemailer": "^6.9.16",
    "pg": "^8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.14.1",
    "styled-components": "^6.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "jest": "^30.3.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "72c44b12-1ab3-4277-91e0-5379a23583c4",
    "installId": "5ea92e2249499a748c90b84f0da855bacf1f58d665d900c8b33473b8ea3dcf8e"
  }

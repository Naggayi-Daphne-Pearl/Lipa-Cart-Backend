            "url": {
              "raw": "{{baseUrl}}/api/orders?populate=*",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {"key": "populate", "value": "*"},
                {"key": "filters[customer][id][$eq]", "value": "1", "disabled": true},
                {"key": "filters[status][$eq]", "value": "pending", "disabled": true},
                {"key": "sort", "value": "createdAt:desc", "disabled": true}
              ]
            },
            "description": "List orders.\n\n**Fields**: customer, shopper, rider, delivery_address, status, subtotal, delivery_fee, total\n**Status**: pending, payment_confirmed, shopping, ready_for_pickup, in_transit, delivered, cancelled"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/:id?populate[order_items][populate]=*&populate[customer]=*&populate[shopper]=*&populate[rider]=*&populate[delivery_address]=*",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", ":id"],
              "variable": [{"key": "id", "value": "1"}],
              "query": [
                {"key": "populate[order_items][populate]", "value": "*"},
                {"key": "populate[customer]", "value": "*"},
                {"key": "populate[shopper]", "value": "*"},
                {"key": "populate[rider]", "value": "*"},
                {"key": "populate[delivery_address]", "value": "*"}
              ]
            },
            "description": "Get order with all nested data."
          }
        },
        {

{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer",
    "description": "Customer-specific profile data"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user.user",
      "inversedBy": "customer"
    },
    "default_address": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::address.address"
    },
    "referral_code": {
      "type": "string",
      "unique": true
    },
    "referred_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer",
      "inversedBy": "referrals"
    },
    "referrals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::customer.customer",
      "mappedBy": "referred_by"
    },
    "total_orders": {
      "type": "integer",
      "default": 0
    },
    "addresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::address.address",
      "mappedBy": "customer"
    },
    "shopping_lists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::shopping-list.shopping-list",
      "mappedBy": "customer"
    }
  }
}

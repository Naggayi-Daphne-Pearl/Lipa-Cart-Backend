{
  "kind": "collectionType",
  "collectionName": "riders",
  "info": {
    "singularName": "rider",
    "pluralName": "riders",
    "displayName": "Rider",
    "description": "Delivery riders who transport orders"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user.user",
      "inversedBy": "rider"
    },
    "vehicle_type": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "license_photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "license_photo_url": {
      "type": "string"
    },
    "id_number": {
      "type": "string"
    },
    "id_photo_url": {
      "type": "string"
    },
    "face_photo_url": {
      "type": "string"
    },
    "kyc_status": {
      "type": "enumeration",
      "enum": ["not_submitted", "pending_review", "approved", "rejected"],
      "default": "not_submitted"
    },
    "kyc_submitted_at": {
      "type": "datetime"
    },
    "kyc_reviewed_at": {
      "type": "datetime"
    },
    "kyc_rejection_reason": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "current_gps_lat": {
      "type": "decimal"
    },
    "current_gps_lng": {
      "type": "decimal"
    },
    "rating": {
      "type": "decimal",
      "default": 0
    },
    "total_ratings": {
      "type": "integer",
      "default": 0
    },
    "total_deliveries_completed": {
      "type": "integer",
      "default": 0
    },
    "total_earnings": {
      "type": "decimal",
      "default": 0
    },
    "mobile_money_provider": {
      "type": "enumeration",
      "enum": ["MTN Mobile Money", "Airtel Money"],
      "default": "MTN Mobile Money"
    },
    "mobile_money_number": {
      "type": "string"
    },
    "bank_account_name": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "training_completed_at": {
      "type": "datetime"
    }
  }
}

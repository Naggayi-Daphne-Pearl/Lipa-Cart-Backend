{
  "kind": "collectionType",
  "collectionName": "shoppers",
  "info": {
    "singularName": "shopper",
    "pluralName": "shoppers",
    "displayName": "Shopper",
    "description": "Personal shoppers who fulfill orders"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user.user",
      "inversedBy": "shopper"
    },
    "market_location": {
      "type": "string"
    },
    "market_gps_lat": {
      "type": "decimal"
    },
    "market_gps_lng": {
      "type": "decimal"
    },
    "id_number": {
      "type": "string"
    },
    "id_photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "id_photo_url": {
      "type": "string"
    },
    "face_photo_url": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "rating": {
      "type": "decimal",
      "default": 0
    },
    "total_ratings": {
      "type": "integer",
      "default": 0
    },
    "total_orders_completed": {
      "type": "integer",
      "default": 0
    },
    "total_earnings": {
      "type": "decimal",
      "default": 0
    },
    "bank_account_name": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "kyc_status": {
      "type": "enumeration",
      "enum": ["not_submitted", "pending_review", "more_info_requested", "approved", "rejected"],
      "default": "not_submitted"
    },
    "face_photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "kyc_rejection_reason": {
      "type": "string"
    },
    "kyc_more_info_requested_fields": {
      "type": "json"
    },
    "kyc_admin_notes": {
      "type": "text",
      "private": true
    },
    "kyc_submitted_at": {
      "type": "datetime"
    },
    "kyc_reviewed_at": {
      "type": "datetime"
    },
    "mobile_money_provider": {
      "type": "enumeration",
      "enum": ["MTN Mobile Money", "Airtel Money"],
      "default": "MTN Mobile Money"
    },
    "mobile_money_number": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "training_completed_at": {
      "type": "datetime"
    }
  }
}

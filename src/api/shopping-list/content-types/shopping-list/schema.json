{
  "kind": "collectionType",
  "collectionName": "shopping_lists",
  "info": {
    "singularName": "shopping-list",
    "pluralName": "shopping-lists",
    "displayName": "Shopping List Template",
    "description": "Pre-made shopping list templates"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "emoji": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "list.item"
    }
  }
}

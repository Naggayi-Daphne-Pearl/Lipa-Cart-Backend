{
  "collectionName": "components_recipe_ingredients",
  "info": {
    "displayName": "Ingredient",
    "description": "Recipe ingredient"
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "quantity": {
      "type": "decimal"
    },
    "unit": {
      "type": "string"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "notes": {
      "type": "string"
    },
    "is_optional": {
      "type": "boolean",
      "default": false
    }
  }
}
